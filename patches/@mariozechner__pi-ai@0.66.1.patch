@@ -41,7 +41,13 @@ if (canUseRuntimeCodegen()) {
  * @throws Error if tool is not found or validation fails
  */
 export function validateToolCall(tools, toolCall) {
-    const tool = tools.find((t) => t.name === toolCall.name);
+    let tool = tools.find((t) => t.name === toolCall.name);
+    if (!tool) {
+        // Fuzzy fallback: strip underscores/hyphens and compare lowercase
+        const normalize = (n) => n.replace(/[_-]/g, "").toLowerCase();
+        const normalizedName = normalize(toolCall.name);
+        tool = tools.find((t) => normalize(t.name) === normalizedName);
+    }
     if (!tool) {
         throw new Error(`Tool "${toolCall.name}" not found`);
     }
