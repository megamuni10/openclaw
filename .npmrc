# pnpm build-script allowlist lives in package.json -> pnpm.onlyBuiltDependencies.
# TS 7 native-preview fails to resolve packages reliably from pnpm's isolated linker.
# Keep the workspace on a hoisted layout so pnpm check/build stay stable.
node-linker=hoisted

# Rollback branch — deps are frozen at v2026.4.16.
# Never update the lockfile accidentally. To intentionally update deps (e.g.
# during a manual cherry-pick), pass --frozen-lockfile=false --config.minimumReleaseAge=0
# explicitly. All other installs must use the committed lockfile as-is.
frozen-lockfile=true
