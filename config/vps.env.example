# Copy to: ~/.openclaw/.env (on the VPS, as the `openclaw` user)
# Permissions: chmod 600 ~/.openclaw/.env
#
# Never commit real values. Keep secrets out of prompts and logs.

# OpenRouter (models)
OPENROUTER_API_KEY="sk-or-..."

# Optional: If you explicitly set gateway auth token in config/env.
# (Onboarding usually generates a token and stores it safely; follow `openclaw doctor` guidance.)
# OPENCLAW_GATEWAY_TOKEN="..."

